# ==============================================================================
# Ambiente de desenvolvimento — MODELO (nunca commite .env com valores reais)
# ==============================================================================
#
# Passos:
#   1. `cp .env.example .env`  (ou rode: `scripts/setup-dev-env.sh` para gerar
#      o .env com senhas ALEATÓRIAS e salvá-lo já em local seguro/ignorado)
#   2. Ajuste o que precisar e suba a stack: `scripts/start.sh`.
#
# NUNCA commit este arquivo com valores reais: o .gitignore ignora `.env`
# e este `.env.example` é só um modelo de referência.
#
# Regras:
#   * Senhas geradas são alfanuméricas (URL-safe) a pedido do setup script.
#   * Se você trocar valores manualmente, use A-Za-z0-9 (evita quebra de
#     DATABASE_URL, que é montada postgres://usuário:senha@...).

# --- Postgres (Superuser de manutenção — usado só por TI, scripts e bootstrap)
POSTGRES_DB=vidasaude
POSTGRES_USER=vidasaude_admin
POSTGRES_PASSWORD=troque-me
POSTGRES_APP_USER=vidasaude_app
POSTGRES_APP_PASSWORD=troque-me

# --- Django
DJANGO_SECRET_KEY=troque-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Admin do painel (criado via seed no boot)
ADMIN_EMAIL=admin@vidasaude.com
ADMIN_NAME=Administrador (VidaSaude)
ADMIN_PASSWORD=troque-me