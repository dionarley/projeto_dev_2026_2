# Porta da API (o Vite faz proxy de /api para cá)
PORT=3333

# Caminho do banco SQLite (um arquivo local; ":memory:" só para debug)
DATABASE_PATH=data.sqlite

# Chave das sessões — troque por algo aleatório (gerar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=

# Credenciais do admin criadas no primeiro start (só valem se o usuário não existir)
ADMIN_EMAIL=admin@vidasaude.com
ADMIN_NAME=Dr. Admin (Gestão)
ADMIN_PASSWORD=admin123