# Frontend (Vite)
# Porta do servidor de dev — a API Django roda em 8000 e recebe /api via proxy.
# PORT=5173
# API_URL=http://localhost:8000
# VITE_BASE=/          # em produção (Docker) o build usa /static/frontend/

#
# O backend Django tem as suas próprias variáveis — gere tudo com
# `scripts/setup-dev-env.sh` (base do repositório): cria backend/.env e o
# .env da raiz com senhas ALEATÓRIAS (nada hardcoded). Veja backend/.env.example.
# Sem backend/.env, o Django usa SQLite local.
#

# Credenciais do admin (aplicadas pelo seed, idempotente) — definidas no backend/.env
# ADMIN_EMAIL=admin@vidasaude.com
# ADMIN_PASSWORD=troque-me