# Frontend (Vite)
# Porta do servidor de dev — a API Django roda em 8000 e recebe /api via proxy.
# PORT=5173
# API_URL=http://localhost:8000
# VITE_BASE=/          # em produção (Docker) o build usa /static/frontend/

#
# O backend Django tem as suas próprias variáveis em backend/.env — veja backend/.env.example.
# Sem backend/.env, o Django usa SQLite local e as credenciais padrão abaixo.
#

# Credenciais do admin (aplicadas pelo `pnpm seed`, idempotente)
# ADMIN_EMAIL=admin@vidasaude.com
# ADMIN_PASSWORD=admin123