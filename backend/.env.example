# Altere as variáveis conforme o ambiente.
# SEM DATABASE_URL o projeto usa SQLite local (arquivo data.sqlite na raiz).
# Com DATABASE_URL (ex.: postgres://...) | usa Postgres (padrão no Docker).

DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

ADMIN_EMAIL=admin@vidasaude.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrador (VidaSaude)

# DATABASE_URL=postgres://vidasaude:vidasaude@localhost:5432/vidasaude