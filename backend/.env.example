# Altere as variáveis conforme o ambiente.
# PREFIRA gerar o ambiente com `scripts/setup-dev-env.sh` (raiz do repo): ele
# cria este arquivo (backend/.env) e o .env da raiz com senhas ALEATÓRIAS.
#
# SEM DATABASE_URL o projeto usa SQLite local (arquivo data.sqlite na raiz).
# Com DATABASE_URL (ex.: postgres://...) | usa Postgres (padrão no Docker).
#
# NUNCA use senha hardcoded: só .env é versionado no .gitignore.

DJANGO_SECRET_KEY=troque-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

ADMIN_EMAIL=admin@vidasaude.com
ADMIN_NAME=Administrador (VidaSaude)
ADMIN_PASSWORD=troque-me

# DATABASE_URL=postgres://vidasaude_app:VIDE_O_ENV_DA_RAIZ@localhost:5432/vidasaude